#!/bin/sh
# Toggles the CPU governor between "performance" and the normal power-saving one.
# Install as root-owned: sudo install -m 755 cpu-gov-toggle /usr/local/bin/
set -e

cur=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
avail=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors)

if [ "$cur" = "performance" ]; then
    # Go back to schedutil if available, otherwise the first non-performance governor
    case " $avail " in
        *" schedutil "*) new=schedutil ;;
        *) new=$(echo "$avail" | tr ' ' '\n' | grep -v '^performance$' | grep -v '^$' | head -n1) ;;
    esac
else
    new=performance
fi

for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    echo "$new" > "$f"
done
