#
# Sway config (i3-compatible syntax)
# Cleaned up and organized by section
#

### ---------------------------------------------------------------------
### Variables
### ---------------------------------------------------------------------
set $mod Mod4

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $refresh_i3status killall -SIGUSR1 i3status


### ---------------------------------------------------------------------
### Input devices
### ---------------------------------------------------------------------
input type:keyboard {
    xkb_layout "fi"
    xkb_model "macintosh"
}


### ---------------------------------------------------------------------
### Appearance / Theming
### ---------------------------------------------------------------------
output eDP-1 scale 1.75
font pango:JetBrainsMono Nerd Font 13

# Widely installed alternative with better unicode coverage, if needed:
# font pango:DejaVu Sans Mono 8

default_border pixel

# Gaps
smart_gaps on
gaps inner 12
gaps outer 4

# Window colors
#                       border    bground   text      indicator child_border
client.focused          #555555   #151515   #d3d7cf   #535758   #222222
client.focused_inactive #333333   #000000   #b8baba   #484e50   #5f676a
client.unfocused        #333333   #222222   #888888   #292d2e   #222222
client.urgent           #2f343a   #900000   #ffffff   #900000   #900000
client.placeholder      #000000   #0c0c0c   #ffffff   #000000   #0c0c0c

# Blur
blur enable
blur_passes 1
blur_radius 2

# Animation
animation_duration_ms 150

# Rounded corners
corner_radius 3

# Shadows
shadows enable
shadow_blur_radius 20
shadow_color #0000004d

# Dim inactive windows
default_dim_inactive 0.15

#layer_effects "waybar" {
#    blur_xray enable;
#    shadows enable;
#    corner_radius 3;
#}

layer_effects "launcher" {
    blur enable;
    shadows enable;
    corner_radius 3;
}

### ---------------------------------------------------------------------
### Bar
### ---------------------------------------------------------------------
exec_always "pkill -x waybar; waybar"


### ---------------------------------------------------------------------
### Autostart
### ---------------------------------------------------------------------
# XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3

# System tray applet for NetworkManager
exec --no-startup-id nm-applet

# Set wallpaper
exec_always swaybg -i ~/Pictures/wallpapers/cassette.png -m fill


### ---------------------------------------------------------------------
### Media keys (volume / mic / brightness)
### ---------------------------------------------------------------------

exec sh -c 'rm -f $SWAYSOCK.wob; mkfifo $SWAYSOCK.wob; tail -f $SWAYSOCK.wob | wob' > /tmp/wob-debug.log 2>&1

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -oE "[0-9]+\.[0-9]+" | awk '{print int($1*100)}' > $SWAYSOCK.wob
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -oE "[0-9]+\.[0-9]+" | awk '{print int($1*100)}' > $SWAYSOCK.wob
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec brightnessctl set +5% && brightnessctl -m -P get > $SWAYSOCK.wob
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && brightnessctl -m -P get > $SWAYSOCK.wob


### ---------------------------------------------------------------------
### Launchers / applications
### ---------------------------------------------------------------------
bindsym $mod+Return exec alacritty
#bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+space exec fuzzel
bindsym $mod+Shift+q kill


### ---------------------------------------------------------------------
### Focus movement
### ---------------------------------------------------------------------
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Arrow key alternatives
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+d focus mode_toggle
bindsym $mod+a focus parent


### ---------------------------------------------------------------------
### Window movement
### ---------------------------------------------------------------------
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


### ---------------------------------------------------------------------
### Layout / floating
### ---------------------------------------------------------------------
floating_modifier $mod

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle


### ---------------------------------------------------------------------
### Workspaces
### ---------------------------------------------------------------------
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


### ---------------------------------------------------------------------
### Resize mode
### ---------------------------------------------------------------------
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"


### ---------------------------------------------------------------------
### Session control
### ---------------------------------------------------------------------

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

### ---------------------------------------------------------------------
### Always floating windows
### ---------------------------------------------------------------------

for_window [class="Vlc"] floating enable

### ---------------------------------------------------------------------
### Lock screen controls
### ---------------------------------------------------------------------

bindsym $mod+Shift+l exec swaylock -c 1e1e2e
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1e1e2e'

### ---------------------------------------------------------------------
### Clipboard settings
### ---------------------------------------------------------------------

exec_always "pkill -x wl-paste; wl-paste --watch cliphist store"
bindsym $mod+Shift+v exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy

### ---------------------------------------------------------------------
### Extra keymappings
### ---------------------------------------------------------------------

#Logout
bindsym $mod+Control+q exec wlogout

#Screenshot
bindsym $mod+shift+s exec grim -g "$(slurp)" - | swappy -f -